#!/bin/bash
# Pre-commit hook for shypn version synchronization validation
# 
# This hook prevents commits with version drift by checking that all
# version-related files are synchronized with the single source of truth.
#
# Installation:
#   cp tools/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Pre-commit: Checking version synchronization..."

# Check if version.py exists
if [ ! -f "src/shypn/version.py" ]; then
    echo -e "${RED}❌ Error: src/shypn/version.py not found${NC}"
    echo "Version synchronization system may not be installed."
    exit 1
fi

# Extract version from version.py
VERSION=$(grep -E '^__version__\s*=\s*"[^"]*"' src/shypn/version.py | sed -E 's/^__version__\s*=\s*"([^"]*)".*/\1/')

if [ -z "$VERSION" ]; then
    echo -e "${RED}❌ Error: Could not extract version from version.py${NC}"
    exit 1
fi

echo -e "   Version source: ${GREEN}$VERSION${NC}"

# Check pyproject.toml
if [ -f "pyproject.toml" ]; then
    PYPROJECT_VER=$(grep '^version = ' pyproject.toml | cut -d'"' -f2)
    if [ "$PYPROJECT_VER" != "$VERSION" ]; then
        echo -e "${RED}❌ VERSION DRIFT in pyproject.toml!${NC}"
        echo "   Expected: $VERSION"
        echo "   Found:    $PYPROJECT_VER"
        echo ""
        echo "Run: ./tools/sync_versions.sh"
        exit 1
    fi
    echo -e "   ✓ pyproject.toml: ${GREEN}$PYPROJECT_VER${NC}"
fi

# Check CITATION.cff
if [ -f "CITATION.cff" ]; then
    CITATION_VER=$(grep '^version: ' CITATION.cff | awk '{print $2}')
    if [ "$CITATION_VER" != "$VERSION" ]; then
        echo -e "${RED}❌ VERSION DRIFT in CITATION.cff!${NC}"
        echo "   Expected: $VERSION"
        echo "   Found:    $CITATION_VER"
        echo ""
        echo "Run: ./tools/sync_versions.sh"
        exit 1
    fi
    echo -e "   ✓ CITATION.cff: ${GREEN}$CITATION_VER${NC}"
fi

# Check that __init__.py imports from version.py
if [ -f "src/shypn/__init__.py" ]; then
    if ! grep -q "from .version import" src/shypn/__init__.py; then
        echo -e "${YELLOW}⚠ Warning: __init__.py doesn't import from version.py${NC}"
        echo "   Expected: from .version import __version__"
    else
        echo -e "   ✓ __init__.py imports from version.py"
    fi
fi

# Test Python imports work
if command -v python3 &> /dev/null; then
    if ! python3 -c "import sys; sys.path.insert(0, 'src'); from shypn import __version__" 2>/dev/null; then
        echo -e "${RED}❌ Error: Cannot import shypn.__version__${NC}"
        echo "Version imports may be broken."
        exit 1
    fi
    echo -e "   ✓ Python imports work"
fi

echo -e "${GREEN}✅ All version checks passed!${NC}"
echo ""
exit 0
