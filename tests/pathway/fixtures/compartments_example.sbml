<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model id="compartments_model" name="Multi-Compartment Model">
    <listOfCompartments>
      <compartment id="cytoplasm" name="Cytoplasm" spatialDimensions="3" size="1.0" constant="true"/>
      <compartment id="mitochondria" name="Mitochondria" spatialDimensions="3" size="0.2" constant="true"/>
      <compartment id="extracellular" name="Extracellular Space" spatialDimensions="3" size="10.0" constant="true"/>
    </listOfCompartments>
    
    <listOfSpecies>
      <species id="glc_ext" name="Glucose (extracellular)" compartment="extracellular" initialConcentration="5.0" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="glc_cyt" name="Glucose (cytoplasm)" compartment="cytoplasm" initialConcentration="1.0" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="pyr_cyt" name="Pyruvate (cytoplasm)" compartment="cytoplasm" initialConcentration="0.1" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="pyr_mit" name="Pyruvate (mitochondria)" compartment="mitochondria" initialConcentration="0.05" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    
    <listOfParameters>
      <parameter id="k_transport" value="0.5" constant="true"/>
      <parameter id="k_glycolysis" value="0.2" constant="true"/>
      <parameter id="k_import" value="0.3" constant="true"/>
    </listOfParameters>
    
    <listOfReactions>
      <reaction id="glucose_transport" name="Glucose Transport" reversible="false">
        <listOfReactants>
          <speciesReference species="glc_ext" stoichiometry="1"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="glc_cyt" stoichiometry="1"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci>k_transport</ci>
              <ci>glc_ext</ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      
      <reaction id="glycolysis" name="Glycolysis" reversible="false">
        <listOfReactants>
          <speciesReference species="glc_cyt" stoichiometry="1"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="pyr_cyt" stoichiometry="2"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci>k_glycolysis</ci>
              <ci>glc_cyt</ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      
      <reaction id="pyruvate_import" name="Pyruvate Import" reversible="false">
        <listOfReactants>
          <speciesReference species="pyr_cyt" stoichiometry="1"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="pyr_mit" stoichiometry="1"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci>k_import</ci>
              <ci>pyr_cyt</ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
