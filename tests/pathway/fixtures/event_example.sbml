<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model id="event_model" name="Model with Events">
    <listOfCompartments>
      <compartment id="cell" spatialDimensions="3" size="1.0" constant="true"/>
    </listOfCompartments>
    
    <listOfSpecies>
      <species id="S1" name="Species 1" compartment="cell" initialConcentration="10" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="S2" name="Species 2" compartment="cell" initialConcentration="0" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    
    <listOfParameters>
      <parameter id="k1" value="0.1" constant="true"/>
      <parameter id="trigger_time" value="10.0" constant="true"/>
    </listOfParameters>
    
    <listOfReactions>
      <reaction id="R1" reversible="false">
        <listOfReactants>
          <speciesReference species="S1" stoichiometry="1"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="S2" stoichiometry="1"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci>k1</ci>
              <ci>S1</ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
    
    <listOfEvents>
      <event id="drug_addition" name="Drug Addition Event" useValuesFromTriggerTime="true">
        <trigger initialValue="false" persistent="true">
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <geq/>
              <csymbol encoding="text" definitionURL="http://www.sbml.org/sbml/symbols/time">time</csymbol>
              <ci>trigger_time</ci>
            </apply>
          </math>
        </trigger>
        <delay>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <cn>2.0</cn>
          </math>
        </delay>
        <priority>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <cn>1</cn>
          </math>
        </priority>
        <listOfEventAssignments>
          <eventAssignment variable="S1">
            <math xmlns="http://www.w3.org/1998/Math/MathML">
              <apply>
                <plus/>
                <ci>S1</ci>
                <cn>5.0</cn>
              </apply>
            </math>
          </eventAssignment>
        </listOfEventAssignments>
      </event>
    </listOfEvents>
  </model>
</sbml>
