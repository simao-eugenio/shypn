<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings Sub-Palette for Simulation - Production Version -->
<interface>
  <requires lib="gtk+" version="3.0"/>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- SETTINGS REVEALER - Inline settings panel for simulation -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->

  <object class="GtkRevealer" id="settings_revealer">
    <property name="visible">True</property>
    <property name="reveal-child">True</property>
    <property name="transition-type">none</property>
    <property name="transition-duration">0</property>

    <child>
      <object class="GtkFrame" id="settings_frame">
        <property name="visible">True</property>
        <property name="shadow-type">out</property>
        <property name="margin_bottom">12</property>
        
        <child>
          <object class="GtkBox" id="settings_container">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <property name="margin">16</property>
            
            <!-- Header -->
            <child>
              <object class="GtkLabel" id="settings_header">
                <property name="visible">True</property>
                <property name="label">⚙ Simulation Settings</property>
                <property name="xalign">0</property>
              </object>
            </child>
            
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- SIMULATION PARAMETERS Expander (open by default) -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            
            <child>
              <object class="GtkExpander" id="simulation_params_expander">
                <property name="visible">True</property>
                <property name="expanded">True</property>
                <property name="margin_top">4</property>
                
                <child type="label">
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="label">SIMULATION PARAMETERS</property>
                  </object>
                </child>
                
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <property name="margin_top">8</property>
                    <property name="margin_start">12</property>
                    
                    <!-- Time Step -->
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">4</property>
                        
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label">Time Step</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                        
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">horizontal</property>
                            <property name="spacing">8</property>
                            
                            <child>
                              <object class="GtkRadioButton" id="dt_auto_radio">
                                <property name="visible">True</property>
                                <property name="label">Auto</property>
                                <property name="active">True</property>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkRadioButton" id="dt_manual_radio">
                                <property name="visible">True</property>
                                <property name="label">Manual</property>
                                <property name="group">dt_auto_radio</property>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkEntry" id="dt_manual_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="editable">True</property>
                                <property name="text">0.06</property>
                                <property name="width-chars">6</property>
                                <property name="sensitive">True</property>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">s</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <!-- Playback Speed -->
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">4</property>
                        
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label">Playback Speed</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                        
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">horizontal</property>
                            <property name="spacing">8</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Speed:</property>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkSpinButton" id="time_scale_spin">
                                <property name="visible">True</property>
                                <property name="adjustment">time_scale_adjustment</property>
                                <property name="digits">3</property>
                                <property name="value">1.0</property>
                                <property name="width-chars">7</property>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">×</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                  </object>
                </child>
              </object>
            </child>
            
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- STOCHASTIC ACCELERATION Expander (collapsed) -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            
            <child>
              <object class="GtkExpander" id="stochastic_expander">
                <property name="visible">True</property>
                <property name="expanded">False</property>
                <property name="margin_top">4</property>
                
                <child type="label">
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="label">STOCHASTIC ACCELERATION</property>
                  </object>
                </child>
                
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin_top">8</property>
                    <property name="margin_start">12</property>
                    
                    <!-- Enable τ-Leaping -->
                    <child>
                      <object class="GtkCheckButton" id="tau_leaping_check">
                        <property name="visible">True</property>
                        <property name="label">Enable τ-Leaping (uncheck for exact SSA)</property>
                        <property name="active">True</property>
                        <property name="tooltip-text">Disable only for debugging or verification</property>
                      </object>
                    </child>
                    
                    <!-- Parameters -->
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label">Accuracy ε:</property>
                          </object>
                        </child>
                        
                        <child>
                          <object class="GtkEntry" id="tau_epsilon_entry">
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="editable">True</property>
                            <property name="text">0.03</property>
                            <property name="width-chars">5</property>
                            <property name="tooltip-text">Lower = more accurate but slower</property>
                          </object>
                        </child>
                        
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label">Critical:</property>
                          </object>
                        </child>
                        
                        <child>
                          <object class="GtkEntry" id="critical_threshold_entry">
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="editable">True</property>
                            <property name="text">10</property>
                            <property name="width-chars">4</property>
                            <property name="tooltip-text">Threshold for exact handling</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <!-- Parallel Execution -->
                    <child>
                      <object class="GtkCheckButton" id="parallel_stochastic_check">
                        <property name="visible">True</property>
                        <property name="label">Enable Parallel Execution</property>
                        <property name="active">True</property>
                        <property name="tooltip-text">Uses weak independence for parallel sampling</property>
                      </object>
                    </child>
                    
                  </object>
                </child>
              </object>
            </child>
            
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- BATCH MODE Expander (collapsed) -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            
            <child>
              <object class="GtkExpander" id="batch_mode_expander">
                <property name="visible">True</property>
                <property name="expanded">False</property>
                <property name="margin_top">4</property>
                
                <child type="label">
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="label">BATCH MODE (EXPERIMENT REPLICATION)</property>
                  </object>
                </child>
                
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin_top">8</property>
                    <property name="margin_start">12</property>
                    
                    <!-- Enable Batch Mode -->
                    <child>
                      <object class="GtkCheckButton" id="batch_mode_enabled_check">
                        <property name="visible">True</property>
                        <property name="label">Enable Batch Mode</property>
                        <property name="active">False</property>
                        <property name="tooltip-text">Run multiple independent simulations for stochastic variability analysis</property>
                      </object>
                    </child>
                    
                    <!-- Replicates -->
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        
                        <child>
                          <object class="GtkLabel" id="batch_replicates_label">
                            <property name="visible">True</property>
                            <property name="label">Replicates:</property>
                            <property name="sensitive">False</property>
                          </object>
                        </child>
                        
                        <child>
                          <object class="GtkSpinButton" id="batch_replicates_spin">
                            <property name="visible">True</property>
                            <property name="adjustment">batch_replicates_adjustment</property>
                            <property name="width-chars">6</property>
                            <property name="sensitive">False</property>
                            <property name="tooltip-text">Number of independent simulation runs</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <!-- Output Folder -->
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        
                        <child>
                          <object class="GtkLabel" id="batch_output_label">
                            <property name="visible">True</property>
                            <property name="label">Output:</property>
                            <property name="sensitive">False</property>
                          </object>
                        </child>
                        
                        <child>
                          <object class="GtkFileChooserButton" id="batch_output_chooser">
                            <property name="visible">True</property>
                            <property name="action">select-folder</property>
                            <property name="title">Select Output Folder</property>
                            <property name="sensitive">False</property>
                            <property name="tooltip-text">Where to save batch results</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <!-- Info tip -->
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">Tip: Right-click places/transitions to mark for recording</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="max-width-chars">40</property>
                      </object>
                    </child>
                    
                  </object>
                </child>
              </object>
            </child>
            
          </object>
        </child>
      </object>
    </child>

  </object>

  <!-- Adjustments -->
  <object class="GtkAdjustment" id="time_scale_adjustment">
    <property name="lower">0.001</property>
    <property name="upper">1000.0</property>
    <property name="step-increment">0.01</property>
    <property name="page-increment">1.0</property>
    <property name="value">1.0</property>
  </object>

  <object class="GtkAdjustment" id="batch_replicates_adjustment">
    <property name="lower">1</property>
    <property name="upper">10000</property>
    <property name="value">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>

</interface>
