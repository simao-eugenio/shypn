<?xml version="1.0" encoding="UTF-8"?>
<!-- Edit Tools Palette - Place, Transition, Arc Buttons -->
<interface>
  <requires lib="gtk+" version="3.0"/>

  <!-- Revealer for floating tools palette -->
  <object class="GtkRevealer" id="tools_revealer">
    <property name="visible">True</property>
    <property name="reveal-child">False</property>
    <property name="transition-type">slide-up</property>
    <property name="transition-duration">200</property>
    <property name="halign">center</property>
    <property name="valign">end</property>
    <property name="margin_bottom">78</property>
    <property name="margin_end">352</property>

    <child>
      <object class="GtkFrame" id="tools_frame">
        <property name="visible">True</property>
        <property name="shadow-type">out</property>
        <style>
          <class name="gray-palette-frame"/>
        </style>
        <child>
          <object class="GtkBox" id="tools_container">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="margin">6</property>

        <!-- Place Tool Button [P] -->
        <child>
          <object class="GtkToggleButton" id="btn_place">
            <property name="visible">True</property>
            <property name="label">P</property>
            <property name="tooltip-text">Place Tool (Ctrl+P)</property>
            <property name="width-request">36</property>
            <property name="height-request">36</property>
          </object>
        </child>

        <!-- Transition Tool Button [T] -->
        <child>
          <object class="GtkToggleButton" id="btn_transition">
            <property name="visible">True</property>
            <property name="label">T</property>
            <property name="tooltip-text">Transition Tool (Ctrl+T)</property>
            <property name="width-request">36</property>
            <property name="height-request">36</property>
          </object>
        </child>

        <!-- Arc Tool Button [A] -->
        <child>
          <object class="GtkToggleButton" id="btn_arc">
            <property name="visible">True</property>
            <property name="label">A</property>
            <property name="tooltip-text">Arc Tool (Ctrl+A)</property>
            <property name="width-request">36</property>
            <property name="height-request">36</property>
          </object>
        </child>

          </object>
        </child>
      </object>
    </child>

  </object>

</interface>
