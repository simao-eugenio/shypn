<?xml version="1.0" encoding="UTF-8"?>
<!-- Enhanced Transition Dialog with Notebook Interface -->
<interface>
  <requires lib="gtk+" version="3.20"/>
  
  <!-- Adjustments -->
  <object class="GtkAdjustment" id="delay_adjustment">
    <property name="upper">10000</property>
    <property name="value">1</property>
    <property name="step-increment">0.10</property>
    <property name="page-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="height_adjustment">
    <property name="lower">10</property>
    <property name="upper">200</property>
    <property name="value">20</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="width_adjustment">
    <property name="lower">10</property>
    <property name="upper">200</property>
    <property name="value">40</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="rate_adjustment">
    <property name="lower">0.001</property>
    <property name="upper">1000</property>
    <property name="value">1</property>
    <property name="step-increment">0.10</property>
    <property name="page-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="priority_adjustment">
    <property name="lower">-100</property>
    <property name="upper">100</property>
    <property name="value">0</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="earliest_time_adjustment">
    <property name="lower">0</property>
    <property name="upper">1000000</property>
    <property name="value">1</property>
    <property name="step-increment">0.1</property>
    <property name="page-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="latest_time_adjustment">
    <property name="lower">0</property>
    <property name="upper">1000000</property>
    <property name="value">1</property>
    <property name="step-increment">0.1</property>
    <property name="page-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="volume_threshold_adjustment">
    <property name="lower">0.001</property>
    <property name="upper">10000</property>
    <property name="value">1.0</property>
    <property name="step-increment">0.1</property>
    <property name="page-increment">1</property>
  </object>

  <!-- Main Dialog -->
  <object class="GtkDialog" id="transition_properties_dialog">
    <property name="can-focus">False</property>
    <property name="border-width">5</property>
    <property name="title" translatable="yes">Transition Properties</property>
    <property name="resizable">True</property>
    <property name="modal">True</property>
    <property name="window-position">center-on-parent</property>
    <property name="type-hint">dialog</property>
    <property name="default-width">500</property>
    <property name="default-height">450</property>
    
    <child internal-child="vbox">
      <object class="GtkBox" id="dialog_vbox">
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        
        <!-- Action Area -->
        <child internal-child="action_area">
          <object class="GtkButtonBox" id="dialog_action_area">
            <property name="can-focus">False</property>
            <property name="layout-style">end</property>
            <child>
              <object class="GtkButton" id="cancel_button">
                <property name="label" translatable="yes">Cancel</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="ok_button">
                <property name="label" translatable="yes">Apply</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="pack-type">end</property>
            <property name="position">0</property>
          </packing>
        </child>
        
        <!-- Main Content -->
        <child>
          <object class="GtkNotebook" id="main_notebook">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="margin-left">10</property>
            <property name="margin-right">10</property>
            <property name="margin-top">10</property>
            <property name="margin-bottom">10</property>
            
            <!-- Basic Properties Tab -->
            <child>
              <object class="GtkBox" id="basic_tab_content">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>
                <property name="spacing">15</property>
                <property name="margin-top">15</property>
                <property name="margin-bottom">15</property>
                <property name="margin-left">15</property>
                <property name="margin-right">15</property>
                
                <!-- General Frame -->
                <child>
                  <object class="GtkFrame" id="general_frame">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label-xalign">0</property>
                    <property name="shadow-type">in</property>
                    <child>
                      <object class="GtkBox" id="general_box">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">8</property>
                        <property name="margin-top">10</property>
                        <property name="margin-bottom">10</property>
                        <property name="margin-left">15</property>
                        <property name="margin-right">15</property>
                        
                        <!-- ID (Read-only) -->
                        <child>
                          <object class="GtkBox" id="id_box">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="id_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">ID:</property>
                                <property name="width-chars">12</property>
                                <property name="xalign">1</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="id_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="editable">False</property>
                                <property name="hexpand">True</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">0</property>
                          </packing>
                        </child>
                        
                        <child>
                          <object class="GtkBox" id="name_box">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="name_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Name:</property>
                                <property name="width-chars">12</property>
                                <property name="xalign">1</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="name_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="hexpand">True</property>
                                <property name="invisible-char">●</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">0</property>
                          </packing>
                        </child>
                        
                        <child>
                          <object class="GtkBox" id="label_box">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="label_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Label:</property>
                                <property name="width-chars">12</property>
                                <property name="xalign">1</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="transition_label_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="hexpand">True</property>
                                <property name="invisible-char">●</property>
                                <property name="placeholder-text">Optional display label</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">1</property>
                          </packing>
                        </child>
                        
                        <!-- Compartment -->
                        <child>
                          <object class="GtkBox" id="compartment_box">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="compartment_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Compartment:</property>
                                <property name="width-chars">12</property>
                                <property name="xalign">1</property>
                                <property name="tooltip-text">Biological compartment (e.g., cytoplasm, lysosome, mitochondria). Used for compartment-specific thermodynamic properties.</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="compartment_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="hexpand">True</property>
                                <property name="invisible-char">●</property>
                                <property name="placeholder-text">cytoplasm, lysosome, mitochondria, etc.</property>
                                <property name="tooltip-text">Specify compartment for context-aware thermodynamic calculations (pH, ionic strength). Leave empty to use document-level defaults.</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">2</property>
                          </packing>
                        </child>
                        
                        <child>
                          <object class="GtkBox" id="type_combo_box">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="type_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Type:</property>
                                <property name="width-chars">12</property>
                                <property name="xalign">1</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkComboBoxText" id="prop_transition_type_combo">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="hexpand">True</property>
                                <property name="active">2</property>
                                <property name="tooltip-text">Select the timing behavior for this transition. Adaptive transitions automatically choose stochastic or continuous mode based on compartment volume.</property>
                                <items>
                                  <item translatable="yes">immediate</item>
                                  <item translatable="yes">timed</item>
                                  <item translatable="yes">stochastic</item>
                                  <item translatable="yes">continuous</item>
                                  <item translatable="yes">adaptive</item>
                                </items>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">1</property>
                          </packing>
                        </child>
                        
                        <!-- Adaptive Properties -->
                        <child>
                          <object class="GtkBox" id="adaptive_properties_box">
                            <property name="visible">False</property>
                            <property name="can-focus">False</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <property name="margin-top">6</property>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">Adaptive Filter:</property>
                                    <property name="xalign">0</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkComboBoxText" id="adaptive_filter_combo">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="hexpand">True</property>
                                    <property name="active">0</property>
                                    <property name="tooltip-text">Which places to check for volume-based mode selection: inputs_only (default), outputs_only, all_places</property>
                                    <items>
                                      <item translatable="yes">inputs_only</item>
                                      <item translatable="yes">outputs_only</item>
                                      <item translatable="yes">all_places</item>
                                    </items>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">Volume Threshold (fL):</property>
                                    <property name="xalign">0</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="volume_threshold_spin">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="hexpand">True</property>
                                    <property name="tooltip-text">Volume threshold in femtoliters. If compartment volume &lt; threshold → stochastic mode, ≥ threshold → continuous mode</property>
                                    <property name="adjustment">volume_threshold_adjustment</property>
                                    <property name="digits">3</property>
                                    <property name="numeric">True</property>
                                    <property name="value">1.0</property>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">2</property>
                          </packing>
                        </child>
                        
                        <!-- Source/Sink Markers -->
                        <child>
                          <object class="GtkBox" id="source_sink_box">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">20</property>
                            <property name="halign">start</property>
                            <child>
                              <object class="GtkCheckButton" id="is_source_check">
                                <property name="label" translatable="yes">Source (generates tokens)</property>
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="receives-default">False</property>
                                <property name="tooltip-text">Source transition generates tokens without consuming input (models external arrivals)</property>
                                <property name="draw-indicator">True</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="is_sink_check">
                                <property name="label" translatable="yes">Sink (consumes tokens)</property>
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="receives-default">False</property>
                                <property name="tooltip-text">Sink transition consumes tokens without producing output (models external departures)</property>
                                <property name="draw-indicator">True</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">3</property>
                          </packing>
                        </child>
                        
                      </object>
                    </child>
                    <child type="label">
                      <object class="GtkLabel" id="general_label">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label" translatable="yes">General Properties</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                
                <!-- Type Parameters Frame -->
                <child>
                  <object class="GtkFrame" id="type_parameters_frame">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label-xalign">0</property>
                    <property name="shadow-type">in</property>
                    <child>
                      <object class="GtkBox" id="type_parameters_box">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">8</property>
                        <property name="margin-top">10</property>
                        <property name="margin-bottom">10</property>
                        <property name="margin-left">15</property>
                        <property name="margin-right">15</property>
                        
                        <!-- Firing Policy Field (replaces Priority spinner) -->
                        <child>
                          <object class="GtkBox" id="firing_policy_box">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="firing_policy_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Policy:</property>
                                <property name="width-chars">12</property>
                                <property name="xalign">1</property>
                                <property name="tooltip-text">Firing policy for conflict resolution when multiple transitions are enabled</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkComboBoxText" id="firing_policy_combo">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="hexpand">True</property>
                                <property name="active">4</property>
                                <property name="tooltip-text">Conflict resolution policy when multiple transitions are enabled simultaneously. Race (default): mass action kinetics for biological realism; Random: uniform selection; Earliest: first enabled fires; Latest: last enabled fires; Priority: uses priority value; Age: FIFO scheduling; Preemptive-Priority: allows interruption; Preemptive: simultaneous-fire ODE-consistent (anti-monopolization); Single: fires alone, no conflict resolution</property>
                                <items>
                                  <item translatable="yes">Random</item>
                                  <item translatable="yes">Earliest</item>
                                  <item translatable="yes">Latest</item>
                                  <item translatable="yes">Priority</item>
                                  <item translatable="yes">Race</item>
                                  <item translatable="yes">Age</item>
                                  <item translatable="yes">Preemptive-Priority</item>
                                  <item translatable="yes">Preemptive</item>
                                  <item translatable="yes">Single</item>
                                </items>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">0</property>
                          </packing>
                        </child>
                        
                        <!-- Priority Value Field (shown only when Policy is Priority or Preemptive-Priority) -->
                        <child>
                          <object class="GtkBox" id="priority_value_box">
                            <property name="visible">False</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="priority_value_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Priority Value:</property>
                                <property name="width-chars">12</property>
                                <property name="xalign">1</property>
                                <property name="tooltip-text">Numeric priority value (higher = fires first). Used when firing policy is Priority or Preemptive-Priority</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkSpinButton" id="priority_value_spin">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="hexpand">True</property>
                                <property name="tooltip-text">Priority value: higher numbers fire first (typical range: 0-10, but any integer allowed)</property>
