<?xml version="1.0" encoding="UTF-8"?>
<!-- Place Properties Dialog -->
<interface>
  <requires lib="gtk+" version="3.20"/>
  
  <!-- Adjustments for spin buttons -->
  <object class="GtkAdjustment" id="thermo_charge_adjustment">
    <property name="lower">-10</property>
    <property name="upper">10</property>
    <property name="step-increment">1</property>
    <property name="page-increment">1</property>
  </object>
  
  <object class="GtkAdjustment" id="thermo_n_protons_adjustment">
    <property name="lower">-10</property>
    <property name="upper">10</property>
    <property name="step-increment">1</property>
    <property name="page-increment">1</property>
  </object>
  
  <object class="GtkAdjustment" id="thermo_ph_adjustment">
    <property name="lower">0</property>
    <property name="upper">14</property>
    <property name="value">7.0</property>
    <property name="step-increment">0.1</property>
    <property name="page-increment">1</property>
  </object>
  
  <object class="GtkAdjustment" id="thermo_temperature_adjustment">
    <property name="lower">273.15</property>
    <property name="upper">373.15</property>
    <property name="value">298.15</property>
    <property name="step-increment">0.1</property>
    <property name="page-increment">10</property>
  </object>
  
  <object class="GtkAdjustment" id="thermo_ionic_strength_adjustment">
    <property name="lower">0</property>
    <property name="upper">1</property>
    <property name="value">0.1</property>
    <property name="step-increment">0.01</property>
    <property name="page-increment">0.1</property>
  </object>
  
  <object class="GtkDialog" id="place_properties_dialog">
    <property name="can-focus">False</property>
    <property name="border-width">5</property>
    <property name="title" translatable="yes">Place Properties</property>
    <property name="resizable">True</property>
    <property name="modal">True</property>
    <property name="window-position">center-on-parent</property>
    <property name="type-hint">dialog</property>
    <property name="default-width">550</property>
    <property name="default-height">500</property>
    
    <child internal-child="vbox">
      <object class="GtkBox" id="dialog_vbox">
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        
        <!-- Action Area -->
        <child internal-child="action_area">
          <object class="GtkButtonBox" id="dialog_action_area">
            <property name="can-focus">False</property>
            <property name="layout-style">end</property>
            
            <child>
              <object class="GtkButton" id="cancel_button">
                <property name="label">gtk-cancel</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <property name="use-stock">True</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            
            <child>
              <object class="GtkButton" id="ok_button">
                <property name="label">gtk-apply</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <property name="can-default">True</property>
                <property name="has-default">True</property>
                <property name="use-stock">True</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="pack-type">end</property>
            <property name="position">0</property>
          </packing>
        </child>
        
        <!-- Notebook with tabs -->
        <child>
          <object class="GtkNotebook" id="main_notebook">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="margin-left">10</property>
            <property name="margin-right">10</property>
            <property name="margin-top">10</property>
            <property name="margin-bottom">10</property>
            
            <!-- Basic Properties Tab -->
            <child>
              <object class="GtkBox" id="basic_tab_content">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>
                <property name="spacing">15</property>
                <property name="margin-top">15</property>
                <property name="margin-bottom">15</property>
                <property name="margin-left">15</property>
                <property name="margin-right">15</property>
                
                <!-- General Properties -->
                <child>
                  <object class="GtkFrame" id="general_frame">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label-xalign">0</property>
                    <property name="shadow-type">in</property>
                    
                    <child>
                      <object class="GtkBox" id="general_box">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">8</property>
                        <property name="margin-top">10</property>
                        <property name="margin-bottom">10</property>
                        <property name="margin-left">15</property>
                        <property name="margin-right">15</property>
                        
                        <!-- ID (Read-only) -->
                        <child>
                          <object class="GtkBox" id="id_box">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="id_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">ID:</property>
                                <property name="width-chars">12</property>
                                <property name="xalign">1</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="id_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="editable">False</property>
                                <property name="width-chars">20</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Name -->
                        <child>
                          <object class="GtkBox" id="name_box">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="name_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Name:</property>
                                <property name="width-chars">12</property>
                                <property name="xalign">1</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="name_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="width-chars">20</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Description -->
                        <child>
                          <object class="GtkBox" id="description_box">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="description_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Description:</property>
                                <property name="width-chars">12</property>
                                <property name="xalign">1</property>
                                <property name="yalign">0</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow" id="description_scroll">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="min-content-height">60</property>
                                <property name="shadow-type">in</property>
                                <child>
                                  <object class="GtkTextView" id="description_text">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="wrap-mode">word</property>
                                  </object>
                                </child>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <child type="label">
                      <object class="GtkLabel" id="general_frame_label">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label" translatable="yes">General Properties</property>
                      </object>
                    </child>
                  </object>
                </child>
                
                <!-- Place Properties -->
                <child>
                  <object class="GtkFrame" id="place_frame">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label-xalign">0</property>
                    <property name="shadow-type">in</property>
                    
                    <child>
                      <object class="GtkBox" id="place_box">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">8</property>
                        <property name="margin-top">10</property>
                        <property name="margin-bottom">10</property>
                        <property name="margin-left">15</property>
                        <property name="margin-right">15</property>
                        
                        <!-- Tokens and Capacity -->
                        <child>
                          <object class="GtkBox" id="tokens_capacity_row">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            
                            <child>
                              <object class="GtkLabel" id="tokens_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Tokens:</property>
                                <property name="width-chars">8</property>
                                <property name="xalign">1</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="prop_place_tokens_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="width-chars">8</property>
                                <property name="placeholder-text" translatable="yes">e.g. 0, 5.5</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                            
                            <child>
                              <object class="GtkLabel" id="capacity_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Capacity:</property>
                                <property name="width-chars">8</property>
                                <property name="xalign">1</property>
                                <property name="tooltip-text" translatable="yes">Maximum number of tokens (inf for unlimited)</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">2</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="prop_place_capacity_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="width-chars">8</property>
                                <property name="placeholder-text" translatable="yes">inf or number</property>
                                <property name="tooltip-text" translatable="yes">Enter a number or 'inf' for unlimited capacity</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">3</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Radius and Width -->
                        <child>
                          <object class="GtkBox" id="radius_width_row">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            
                            <child>
                              <object class="GtkLabel" id="radius_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Radius:</property>
                                <property name="width-chars">8</property>
                                <property name="xalign">1</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="prop_place_radius_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="width-chars">8</property>
                                <property name="placeholder-text" translatable="yes">e.g. 30</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                            
                            <child>
                              <object class="GtkLabel" id="width_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Width:</property>
                                <property name="width-chars">8</property>
                                <property name="xalign">1</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">2</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="prop_place_width_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="width-chars">8</property>
                                <property name="placeholder-text" translatable="yes">e.g. 2</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">3</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <child type="label">
                      <object class="GtkLabel" id="place_frame_label">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label" translatable="yes">Place Properties</property>
                      </object>
                    </child>
                  </object>
                </child>
                
                <!-- Color Properties -->
                <child>
                  <object class="GtkFrame" id="color_frame">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label-xalign">0</property>
                    <property name="shadow-type">in</property>
                    
                    <child>
                      <object class="GtkBox" id="place_color_picker">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">10</property>
                        <property name="margin-top">15</property>
                        <property name="margin-bottom">15</property>
                        <property name="margin-left">15</property>
                        <property name="margin-right">15</property>
                      </object>
                    </child>
                    
                    <child type="label">
                      <object class="GtkLabel" id="color_frame_label">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label" translatable="yes">Color &amp; Appearance</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            
            <child type="tab">
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Basic</property>
              </object>
            </child>
            
            <!-- Signaling Tab -->
            <child>
              <object class="GtkBox" id="signaling_tab_content">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>
                <property name="spacing">15</property>
                <property name="margin-top">15</property>
                <property name="margin-bottom">15</property>
                <property name="margin-left">15</property>
                <property name="margin-right">15</property>
                
                <!-- Signal Place Properties Frame -->
                <child>
                  <object class="GtkFrame" id="signal_frame">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label-xalign">0</property>
                    <property name="shadow-type">in</property>
                    
                    <child>
                      <object class="GtkBox" id="signal_box">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-top">15</property>
                        <property name="margin-bottom">15</property>
                        <property name="margin-left">15</property>
                        <property name="margin-right">15</property>
                        
                        <!-- Signal Place Checkbox -->
                        <child>
                          <object class="GtkCheckButton" id="signal_place_checkbox">
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="label" translatable="yes">Enable Signal Place (Ψ) - Communication/Information Flow</property>
                            <property name="tooltip-text" translatable="yes">Signal places carry information that can be sensed by multiple transitions without token consumption. Used for inter-module communication.</property>
                          </object>
                        </child>
                        
                        <!-- Signal Type Selector -->
                        <child>
                          <object class="GtkBox" id="signal_type_box">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="spacing">10</property>
                            
                            <child>
                              <object class="GtkLabel" id="signal_type_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Signal Type:</property>
                                <property name="width-chars">12</property>
                                <property name="xalign">1</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            
                            <child>
                              <object class="GtkComboBoxText" id="signal_type_combo">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="active">0</property>
                                <property name="tooltip-text" translatable="yes">Type of signal this place represents</property>
                                <items>
                                  <item id="energy" translatable="yes">Ψₑ - Energy/Metabolic State</item>
                                  <item id="regulatory" translatable="yes">Ψᵣ - Regulatory/Gene Expression</item>
                                  <item id="quorum" translatable="yes">Ψq - Quorum/Cell Communication</item>
                                  <item id="spatial" translatable="yes">Ψₛ - Spatial/Compartment Sensing</item>
                                </items>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <child type="label">
                      <object class="GtkLabel" id="signal_frame_label">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label" translatable="yes">Signal Configuration</property>
                        <attributes>
                          <attribute name="weight" value="bold"/>
                        </attributes>
                      </object>
                    </child>
                  </object>
                </child>
                
                <!-- Signal Theory / Help Frame -->
                <child>
                  <object class="GtkFrame" id="signal_help_frame">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label-xalign">0</property>
                    <property name="shadow-type">in</property>
                    
                    <child>
                      <object class="GtkBox" id="signal_help_box">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">10</property>
                        <property name="margin-top">15</property>
                        <property name="margin-bottom">15</property>
                        <property name="margin-left">15</property>
                        <property name="margin-right">15</property>
                        
                        <child>
                          <object class="GtkLabel" id="signal_help_title">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="xalign">0</property>
                            <property name="label" translatable="yes">Communication/Signal Theory</property>
                            <attributes>
                              <attribute name="weight" value="bold"/>
                            </attributes>
                          </object>
                        </child>
                        
                        <child>
                          <object class="GtkLabel" id="signal_help_text">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="xalign">0</property>
                            <property name="yalign">0</property>
                            <property name="wrap">True</property>
                            <property name="selectable">True</property>
                            <property name="label" translatable="yes">Signal places enable modular Petri net architecture through information flow without mass transfer. They serve two purposes:

• Isolated signals (no arcs): Act as SBML-like parameters (temperature, pH, external conditions)
• Connected signals (has arcs): Enable inter-module communication (quorum sensing, paracrine signaling, energy state)

Key properties:
- Tokens can be produced by transitions (accumulate signal)
- Tokens are NOT consumed by transitions (test/read arc semantics)
- Other transitions sense via rate formulas (non-consuming read)
- Visual: Rendered as hexagons with blue border (Ψ symbol)</property>
                            <attributes>
                              <attribute name="scale" value="0.95"/>
                            </attributes>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <child type="label">
                      <object class="GtkLabel" id="signal_help_frame_label">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label" translatable="yes">About Signal Places</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            
            <child type="tab">
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Signaling</property>
              </object>
            </child>
            
            <!-- Spatial Properties Tab -->
            <child>
              <object class="GtkScrolledWindow">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <child>
                  <object class="GtkViewport">
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin">12</property>
                        
                        <!-- Compartment Volume -->
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Compartment Volume (fL):</property>
                                <property name="width-chars">30</property>
                                <property name="xalign">0</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="compartment_volume_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="hexpand">True</property>
                                <property name="placeholder-text">e.g., 1.0</property>
                                <property name="tooltip-text">Volume in femtoliters. Governs adaptive mode selection (&lt;1.0 fL → stochastic, ≥1.0 fL → continuous). Leave empty for null.</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Diffusion Coefficient -->
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Diffusion Coefficient (μm²/s):</property>
                                <property name="width-chars">30</property>
                                <property name="xalign">0</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="diffusion_coefficient_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="hexpand">True</property>
                                <property name="placeholder-text">e.g., 50.0</property>
                                <property name="tooltip-text">Diffusion rate in μm²/s. Typical range: 20-150 μm²/s for cytoplasm. Leave empty for null.</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Boundary Type -->
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Boundary Type:</property>
                                <property name="width-chars">30</property>
                                <property name="xalign">0</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkComboBoxText" id="boundary_type_combo">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="hexpand">True</property>
                                <property name="active">0</property>
                                <property name="tooltip-text">PERMEABLE: free diffusion, SELECTIVE: requires validated transport, IMPERMEABLE: no crossing</property>
                                <items>
                                  <item>None</item>
                                  <item>PERMEABLE</item>
                                  <item>SELECTIVE</item>
                                  <item>IMPERMEABLE</item>
                                </items>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Module ID -->
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Module/Compartment ID:</property>
                                <property name="width-chars">30</property>
                                <property name="xalign">0</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="module_id_entry">
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="hexpand">True</property>
                                <property name="placeholder-text">e.g., cytoplasm, extracellular, membrane</property>
                                <property name="tooltip-text">Compartment identifier. Leave empty for null.</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Gradient Vector -->
                        <child>
                          <object class="GtkFrame">
                            <property name="visible">True</property>
                            <property name="label-xalign">0</property>
                            <child type="label">
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Gradient Vector (for spatial signals)</property>
                                <property name="use-markup">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <property name="margin">6</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="visible">True</property>
                                        <property name="label">dx:</property>
                                        <property name="width-chars">5</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="gradient_vector_dx_entry">
                                        <property name="visible">True</property>
                                        <property name="can-focus">True</property>
                                        <property name="hexpand">True</property>
                                        <property name="placeholder-text">0.0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="visible">True</property>
                                        <property name="label">dy:</property>
                                        <property name="width-chars">5</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="gradient_vector_dy_entry">
                                        <property name="visible">True</property>
                                        <property name="can-focus">True</property>
                                        <property name="hexpand">True</property>
                                        <property name="placeholder-text">0.0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="visible">True</property>
                                        <property name="label">dz:</property>
                                        <property name="width-chars">5</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="gradient_vector_dz_entry">
                                        <property name="visible">True</property>
                                        <property name="can-focus">True</property>
                                        <property name="hexpand">True</property>
                                        <property name="placeholder-text">0.0</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Spatial Position -->
                        <child>
                          <object class="GtkFrame">
                            <property name="visible">True</property>
                            <property name="label-xalign">0</property>
                            <child type="label">
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Spatial Position (μm)</property>
                                <property name="use-markup">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <property name="margin">6</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="visible">True</property>
                                        <property name="label">x:</property>
                                        <property name="width-chars">5</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="spatial_position_x_entry">
                                        <property name="visible">True</property>
                                        <property name="can-focus">True</property>
                                        <property name="hexpand">True</property>
                                        <property name="placeholder-text">0.0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="visible">True</property>
                                        <property name="label">y:</property>
                                        <property name="width-chars">5</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="spatial_position_y_entry">
                                        <property name="visible">True</property>
                                        <property name="can-focus">True</property>
                                        <property name="hexpand">True</property>
                                        <property name="placeholder-text">0.0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="visible">True</property>
                                        <property name="label">z:</property>
                                        <property name="width-chars">5</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="spatial_position_z_entry">
                                        <property name="visible">True</property>
                                        <property name="can-focus">True</property>
                                        <property name="hexpand">True</property>
                                        <property name="placeholder-text">0.0</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Neighbor Compartments -->
                        <child>
                          <object class="GtkFrame">
                            <property name="visible">True</property>
                            <property name="label-xalign">0</property>
                            <child type="label">
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Neighbor Compartments</property>
                                <property name="use-markup">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <property name="margin">6</property>
                                <child>
                                  <object class="GtkScrolledWindow">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="height-request">100</property>
                                    <child>
                                      <object class="GtkTextView" id="neighbor_compartments_textview">
                                        <property name="visible">True</property>
                                        <property name="can-focus">True</property>
                                        <property name="wrap-mode">word</property>
                                        <property name="tooltip-text">Enter neighbor compartment IDs, one per line (e.g., cytoplasm, extracellular)</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            
            <child type="tab">
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Spatial Properties</property>
              </object>
            </child>
            
            <!-- Thermodynamics Tab -->
            <child>
              <object class="GtkScrolledWindow">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <child>
                  <object class="GtkBox" id="thermodynamics_tab_content">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">15</property>
                    <property name="margin-top">15</property>
                    <property name="margin-bottom">15</property>
                    <property name="margin-left">15</property>
                    <property name="margin-right">15</property>
                    
                    <!-- Compound Identification Frame -->
                    <child>
                      <object class="GtkFrame" id="thermo_compound_frame">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label-xalign">0</property>
                        <property name="shadow-type">in</property>
                        
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin">15</property>
                            
                            <!-- Compound ID -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">Compound ID:</property>
                                    <property name="width-chars">15</property>
                                    <property name="xalign">1</property>
                                    <property name="tooltip-text">BiGG or CHEBI identifier (e.g., C00002, CHEBI:15422)</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="thermo_compound_id_entry">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="placeholder-text">e.g., C00002, CHEBI:15422</property>
                                    <property name="tooltip-text">Enter BiGG (Cxxxxx) or CHEBI identifier</property>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                            
                            <!-- Compound Name (Read-only) -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">Compound Name:</property>
                                    <property name="width-chars">15</property>
                                    <property name="xalign">1</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="thermo_compound_name_label">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="xalign">0</property>
                                    <property name="label">-</property>
                                    <property name="selectable">True</property>
                                    <attributes>
                                      <attribute name="style" value="italic"/>
                                    </attributes>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                            
                            <!-- Fetch Button -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <property name="halign">end</property>
                                <child>
                                  <object class="GtkSpinner" id="thermo_fetch_spinner">
                                    <property name="visible">False</property>
                                    <property name="can-focus">False</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">False</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkButton" id="thermo_fetch_button">
                                    <property name="label" translatable="yes">Fetch from Database</property>
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="receives-default">True</property>
                                    <property name="tooltip-text">Query eQuilibrator/BRENDA for compound data</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">False</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <child type="label">
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Compound Identification</property>
                            <attributes>
                              <attribute name="weight" value="bold"/>
                            </attributes>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <!-- Fetch Conditions Frame -->
                    <child>
                      <object class="GtkFrame" id="thermo_conditions_frame">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label-xalign">0</property>
                        <property name="shadow-type">in</property>
                        
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin">15</property>
                            
                            <!-- pH -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">pH:</property>
                                    <property name="width-chars">15</property>
                                    <property name="xalign">1</property>
                                    <property name="tooltip-text">pH value for thermodynamic calculations (typically 7.0 for biochemical standard state)</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="thermo_ph_spin">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="adjustment">thermo_ph_adjustment</property>
                                    <property name="digits">1</property>
                                    <property name="numeric">True</property>
                                    <property name="tooltip-text">pH affects protonation states and free energy</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">(biochemical standard: 7.0)</property>
                                    <property name="xalign">0</property>
                                    <attributes>
                                      <attribute name="style" value="italic"/>
                                      <attribute name="scale" value="0.9"/>
                                    </attributes>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">2</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                            
                            <!-- Temperature -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">Temperature (K):</property>
                                    <property name="width-chars">15</property>
                                    <property name="xalign">1</property>
                                    <property name="tooltip-text">Temperature in Kelvin for thermodynamic calculations</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="thermo_temperature_spin">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="adjustment">thermo_temperature_adjustment</property>
                                    <property name="digits">2</property>
                                    <property name="numeric">True</property>
                                    <property name="tooltip-text">Temperature affects reaction energetics</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">(standard: 298.15 K / 25°C)</property>
                                    <property name="xalign">0</property>
                                    <attributes>
                                      <attribute name="style" value="italic"/>
                                      <attribute name="scale" value="0.9"/>
                                    </attributes>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">2</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                            
                            <!-- Ionic Strength -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">Ionic Strength (M):</property>
                                    <property name="width-chars">15</property>
                                    <property name="xalign">1</property>
                                    <property name="tooltip-text">Ionic strength of the solution in molar units</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="thermo_ionic_strength_spin">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="adjustment">thermo_ionic_strength_adjustment</property>
                                    <property name="digits">3</property>
                                    <property name="numeric">True</property>
                                    <property name="tooltip-text">Ionic strength affects electrostatic interactions</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">(typical: 0.1 - 0.25 M)</property>
                                    <property name="xalign">0</property>
                                    <attributes>
                                      <attribute name="style" value="italic"/>
                                      <attribute name="scale" value="0.9"/>
                                    </attributes>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">2</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                            
                            <!-- Search by Name -->
                            <child>
                              <object class="GtkSeparator">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="margin-top">6</property>
                                <property name="margin-bottom">6</property>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">Search by Name:</property>
                                    <property name="width-chars">15</property>
                                    <property name="xalign">1</property>
                                    <property name="tooltip-text">Search for compound by common name (e.g., ATP, Glucose)</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="thermo_search_name_entry">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="placeholder-text">e.g., ATP, Glucose, NADH</property>
                                    <property name="tooltip-text">Enter compound name to search</property>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkButton" id="thermo_search_button">
                                    <property name="label" translatable="yes">Search</property>
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="receives-default">True</property>
                                    <property name="tooltip-text">Search equilibrator database by name</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">False</property>
                                    <property name="position">2</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <child type="label">
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Fetch Conditions &amp; Search</property>
                            <attributes>
                              <attribute name="weight" value="bold"/>
                            </attributes>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <!-- Thermodynamic Data Frame -->
                    <child>
                      <object class="GtkFrame" id="thermo_data_frame">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label-xalign">0</property>
                        <property name="shadow-type">in</property>
                        
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin">15</property>
                            
                            <!-- ΔGf° (Standard Gibbs Formation Energy) -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">ΔG°f (kJ/mol):</property>
                                    <property name="use-markup">True</property>
                                    <property name="width-chars">15</property>
                                    <property name="xalign">1</property>
                                    <property name="tooltip-text">Standard Gibbs free energy of formation</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="thermo_delta_g_entry">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="width-chars">12</property>
                                    <property name="placeholder-text">e.g., -2292.5</property>
                                    <property name="tooltip-text">Standard Gibbs free energy of formation in kJ/mol (negative values indicate stability)</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">  </property>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">2</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                            
                            <!-- Charge -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">Charge (at pH 7):</property>
                                    <property name="width-chars">15</property>
                                    <property name="xalign">1</property>
                                    <property name="tooltip-text">Net charge of molecule at pH 7.0</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="thermo_charge_spin">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="adjustment">thermo_charge_adjustment</property>
                                    <property name="numeric">True</property>
                                    <property name="tooltip-text">Integer charge value (e.g., -4 for ATP⁴⁻)</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">  </property>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">2</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                            
                            <!-- #Protons -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">#Protons:</property>
                                    <property name="width-chars">15</property>
                                    <property name="xalign">1</property>
                                    <property name="tooltip-text">Number of protons bound/released (used for pH corrections)</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="thermo_n_protons_spin">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="adjustment">thermo_n_protons_adjustment</property>
                                    <property name="numeric">True</property>
                                    <property name="tooltip-text">Number of protons for pH-dependent ΔG corrections</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">  </property>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">2</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                            
                            <!-- pKa Values -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">pKa Values:</property>
                                    <property name="width-chars">15</property>
                                    <property name="xalign">1</property>
                                    <property name="tooltip-text">Acid dissociation constants (comma-separated)</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="thermo_pka_entry">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="placeholder-text">e.g., 6.5, 4.0, 2.0</property>
                                    <property name="tooltip-text">Enter pKa values separated by commas (e.g., 6.5, 4.0)</property>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <child type="label">
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Thermodynamic Data</property>
                            <attributes>
                              <attribute name="weight" value="bold"/>
                            </attributes>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <!-- Data Source Frame -->
                    <child>
                      <object class="GtkFrame" id="thermo_source_frame">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label-xalign">0</property>
                        <property name="shadow-type">in</property>
                        
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin">15</property>
                            
                            <!-- Data Source Selector -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">Data Source:</property>
                                    <property name="width-chars">15</property>
                                    <property name="xalign">1</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkComboBoxText" id="thermo_source_combo">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="active">0</property>
                                    <items>
                                      <item id="none">None</item>
                                      <item id="manual">Manual Entry</item>
                                      <item id="equilibrator">eQuilibrator</item>
                                      <item id="brenda">BRENDA</item>
                                    </items>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">  </property>
                                  </object>
                                  <packing>
                                    <property name="expand">True</property>
                                    <property name="fill">True</property>
                                    <property name="position">2</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                            
                            <!-- Action Buttons -->
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">10</property>
                                <property name="halign">end</property>
                                <child>
                                  <object class="GtkButton" id="thermo_clear_button">
                                    <property name="label" translatable="yes">Clear All</property>
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="receives-default">True</property>
                                    <property name="tooltip-text">Clear all thermodynamic data</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">False</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <child type="label">
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Metadata</property>
                            <attributes>
                              <attribute name="weight" value="bold"/>
                            </attributes>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <!-- Bulk Operations Frame -->
                    <child>
                      <object class="GtkFrame" id="thermo_bulk_ops_frame">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label-xalign">0</property>
                        <property name="shadow-type">in</property>
                        
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="orientation">horizontal</property>
                            <property name="spacing">10</property>
                            <property name="margin">15</property>
                            <property name="halign">center</property>
                            
                            <child>
                              <object class="GtkButton" id="thermo_import_csv_button">
                                <property name="label" translatable="yes">Import from CSV...</property>
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="receives-default">True</property>
                                <property name="tooltip-text">Bulk import thermodynamic data from CSV file</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">False</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            
                            <child>
                              <object class="GtkButton" id="thermo_export_csv_button">
                                <property name="label" translatable="yes">Export to CSV...</property>
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="receives-default">True</property>
                                <property name="tooltip-text">Export cached thermodynamic data to CSV file</property>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">False</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                        
                        <child type="label">
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Bulk Operations</property>
                            <attributes>
                              <attribute name="weight" value="bold"/>
                            </attributes>
                          </object>
                        </child>
                      </object>
                    </child>
                    
                    <!-- Help Text -->
                    <child>
                      <object class="GtkFrame">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label-xalign">0</property>
                        <property name="shadow-type">in</property>
                        
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="xalign">0</property>
                            <property name="yalign">0</property>
                            <property name="margin">15</property>
                            <property name="wrap">True</property>
                            <property name="selectable">True</property>
                            <property name="label" translatable="yes">Thermodynamic properties enable:
• Place-aware validation (pH, temperature from spatial places)
• Reversible reaction thermodynamic consistency (ΔG° ↔ Keq)
• pH-dependent equilibrium shifts (pKa corrections)
• Compound annotation from databases (BiGG, CHEBI)

Use "Fetch from Database" to query eQuilibrator for experimental data. Set "Data Source" to track data provenance.</property>
                            <attributes>
                              <attribute name="scale" value="0.90"/>
                            </attributes>
                          </object>
                        </child>
                        
                        <child type="label">
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">About Thermodynamic Properties</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            
            <child type="tab">
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Thermodynamics</property>
              </object>
            </child>
          </object>
          
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
      </object>
    </child>
    
    <action-widgets>
      <action-widget response="-6">cancel_button</action-widget>
      <action-widget response="-5">ok_button</action-widget>
    </action-widgets>
  </object>
</interface>
