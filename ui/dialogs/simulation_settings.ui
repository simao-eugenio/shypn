<?xml version="1.0" encoding="UTF-8"?>
<!-- Simulation Settings Dialog - Advanced Configuration -->
<interface>
  <requires lib="gtk+" version="3.0"/>

  <object class="GtkDialog" id="simulation_settings_dialog">
    <property name="title" translatable="yes">Simulation Settings</property>
    <property name="modal">True</property>
    <property name="window-position">center-on-parent</property>
    <property name="default-width">450</property>
    <property name="default-height">350</property>
    <property name="type-hint">dialog</property>
    <style>
      <class name="simulation-settings-dialog"/>
    </style>

    <!-- Dialog Content Area -->
    <child internal-child="vbox">
      <object class="GtkBox" id="dialog_content">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>

        <!-- Main Box Container -->
        <child>
          <object class="GtkBox" id="settings_box">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <property name="margin">20</property>
            <style>
              <class name="settings-box"/>
            </style>

            <!-- Simulation Parameters Expander -->
            <child>
              <object class="GtkExpander" id="simulation_params_expander">
                <property name="visible">True</property>
                <property name="expanded">True</property>
                <property name="label" translatable="yes">Simulation Parameters</property>

                <child>
                  <object class="GtkBox" id="sim_params_box">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <property name="margin">12</property>

                    <!-- Time Step -->
                    <child>
                      <object class="GtkGrid" id="timestep_grid">
                        <property name="visible">True</property>
                        <property name="row-spacing">8</property>
                        <property name="column-spacing">8</property>
                        
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Time Step:</property>
                            <property name="xalign">0</property>
                            <property name="hexpand">False</property>
                          </object>
                          <packing>
                            <property name="left-attach">0</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkRadioButton" id="dt_auto_radio">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Automatic (Recommended)</property>
                            <property name="active">True</property>
                            <property name="tooltip-text">Time step automatically calculated as duration/1000</property>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">0</property>
                            <property name="width">2</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkRadioButton" id="dt_manual_radio">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Manual:</property>
                            <property name="group">dt_auto_radio</property>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">1</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkEntry" id="dt_manual_entry">
                            <property name="visible">True</property>
                            <property name="text">0.1</property>
                            <property name="width-chars">10</property>
                            <property name="tooltip-text">Time step in seconds</property>
                          </object>
                          <packing>
                            <property name="left-attach">2</property>
                            <property name="top-attach">1</property>
                          </packing>
                        </child>
                      </object>
                    </child>

                    <!-- Time Scale -->
                    <child>
                      <object class="GtkGrid" id="timescale_grid">
                        <property name="visible">True</property>
                        <property name="column-spacing">8</property>

                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Time Scale Factor:</property>
                            <property name="xalign">0</property>
                          </object>
                          <packing>
                            <property name="left-attach">0</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkEntry" id="time_scale_entry">
                            <property name="visible">True</property>
                            <property name="text">1.0</property>
                            <property name="width-chars">10</property>
                            <property name="tooltip-text">1.0 = real-time, 1000 = compressed</property>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">(1.0 = real-time)</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                          <packing>
                            <property name="left-attach">2</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>
                      </object>
                    </child>

                    <!-- Conflict Resolution -->
                    <child>
                      <object class="GtkGrid" id="conflict_grid">
                        <property name="visible">True</property>
                        <property name="column-spacing">8</property>

                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Conflict Policy:</property>
                            <property name="xalign">0</property>
                          </object>
                          <packing>
                            <property name="left-attach">0</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkComboBoxText" id="conflict_policy_combo">
                            <property name="visible">True</property>
                            <property name="active">0</property>
                            <property name="tooltip-text">How to select when multiple transitions are enabled</property>
                            <items>
                              <item translatable="yes">Random</item>
                              <item translatable="yes">Priority</item>
                              <item translatable="yes">Round Robin</item>
                            </items>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>
                      </object>
                    </child>

                  </object>
                </child>
              </object>
            </child>

            <!-- τ-Leaping Expander -->
            <child>
              <object class="GtkExpander" id="tau_leaping_expander">
                <property name="visible">True</property>
                <property name="expanded">False</property>
                <property name="label" translatable="yes">Stochastic Acceleration (τ-Leaping)</property>

                <child>
                  <object class="GtkBox" id="tau_leaping_box">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin">12</property>

                    <!-- Info label -->
                    <child>
                      <object class="GtkLabel" id="tau_info_label">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">τ-Leaping with parallel execution is enabled by default for maximum performance (20-400× faster). Disable only for debugging.</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="max-width-chars">50</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>

                    <!-- Enable τ-Leaping Checkbox -->
                    <child>
                      <object class="GtkCheckButton" id="tau_leaping_enabled_check">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Enable τ-Leaping</property>
                        <property name="active">True</property>
                        <property name="tooltip-text">Uncheck to use exact Gillespie SSA (slower, for verification only)</property>
                      </object>
                    </child>

                    <!-- Parameters Grid -->
                    <child>
                      <object class="GtkGrid" id="tau_params_grid">
                        <property name="visible">True</property>
                        <property name="row-spacing">8</property>
                        <property name="column-spacing">8</property>

                        <!-- Epsilon -->
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Epsilon (ε):</property>
                            <property name="xalign">0</property>
                          </object>
                          <packing>
                            <property name="left-attach">0</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkEntry" id="tau_epsilon_entry">
                            <property name="visible">True</property>
                            <property name="text">0.03</property>
                            <property name="width-chars">8</property>
                            <property name="tooltip-text">Controls accuracy (lower = more accurate but slower)</property>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">(default: 0.03)</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                          <packing>
                            <property name="left-attach">2</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>

                        <!-- Critical Threshold -->
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Critical Threshold:</property>
                            <property name="xalign">0</property>
                          </object>
                          <packing>
                            <property name="left-attach">0</property>
                            <property name="top-attach">1</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkEntry" id="critical_threshold_entry">
                            <property name="visible">True</property>
                            <property name="text">10</property>
                            <property name="width-chars">8</property>
                            <property name="tooltip-text">Transitions with propensity below this use exact SSA</property>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">1</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">(default: 10)</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                          <packing>
                            <property name="left-attach">2</property>
                            <property name="top-attach">1</property>
                          </packing>
                        </child>
                      </object>
                    </child>

                    <!-- Enable Parallel Checkbox -->
                    <child>
                      <object class="GtkCheckButton" id="parallel_stochastic_check">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Enable Parallel Execution</property>
                        <property name="active">True</property>
                        <property name="tooltip-text">Uses weak independence for parallel sampling (enabled by default, 2-4× additional speedup)</property>
                      </object>
                    </child>

                  </object>
                </child>
              </object>
            </child>

            <!-- Batch Mode Expander -->
            <child>
              <object class="GtkExpander" id="batch_mode_expander">
                <property name="visible">True</property>
                <property name="expanded">False</property>
                <property name="label" translatable="yes">Batch Mode (Experiment Replication)</property>

                <child>
                  <object class="GtkBox" id="batch_mode_box">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin">12</property>

                    <!-- Enable Batch Mode Checkbox -->
                    <child>
                      <object class="GtkCheckButton" id="batch_mode_enabled_check">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Enable Batch Mode</property>
                        <property name="active">False</property>
                        <property name="tooltip-text">Run multiple independent simulations with same initial conditions (for stochastic variability analysis)</property>
                      </object>
                    </child>

                    <!-- Parameters Grid -->
                    <child>
                      <object class="GtkGrid" id="batch_params_grid">
                        <property name="visible">True</property>
                        <property name="row-spacing">8</property>
                        <property name="column-spacing">8</property>

                        <!-- Replicates -->
                        <child>
                          <object class="GtkLabel" id="batch_replicates_label">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Number of Replicates:</property>
                            <property name="xalign">0</property>
                            <property name="sensitive">False</property>
                          </object>
                          <packing>
                            <property name="left-attach">0</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkSpinButton" id="batch_replicates_spin">
                            <property name="visible">True</property>
                            <property name="adjustment">batch_replicates_adjustment</property>
                            <property name="sensitive">False</property>
                            <property name="tooltip-text">How many independent simulation runs to execute</property>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>

                        <!-- Output Folder -->
                        <child>
                          <object class="GtkLabel" id="batch_output_label">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Output Folder:</property>
                            <property name="xalign">0</property>
                            <property name="sensitive">False</property>
                          </object>
                          <packing>
                            <property name="left-attach">0</property>
                            <property name="top-attach">1</property>
                          </packing>
                        </child>

                        <child>
                          <object class="GtkFileChooserButton" id="batch_output_chooser">
                            <property name="visible">True</property>
                            <property name="action">select-folder</property>
                            <property name="title" translatable="yes">Select Output Folder</property>
                            <property name="sensitive">False</property>
                            <property name="tooltip-text">Where to save batch results (CSV files and statistics)</property>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">1</property>
                          </packing>
                        </child>
                      </object>
                    </child>

                    <!-- Info label -->
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Tip: Right-click places/transitions to mark them for recording in batch mode</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="max-width-chars">50</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>

                  </object>
                </child>
              </object>
            </child>

          </object>
        </child>

      </object>
    </child>

    <!-- Dialog Action Area -->
    <action-widgets>
      <action-widget response="-6">cancel_button</action-widget>
      <action-widget response="-5">apply_button</action-widget>
    </action-widgets>

    <child type="action">
      <object class="GtkButton" id="cancel_button">
        <property name="label">gtk-cancel</property>
        <property name="visible">True</property>
        <property name="can_focus">True</property>
        <property name="receives_default">True</property>
        <property name="use_stock">True</property>
      </object>
    </child>

    <child type="action">
      <object class="GtkButton" id="apply_button">
        <property name="label">gtk-apply</property>
        <property name="visible">True</property>
        <property name="can_focus">True</property>
        <property name="receives_default">True</property>
        <property name="use_stock">True</property>
      </object>
    </child>

  </object>

  <!-- Adjustment for Batch Replicates -->
  <object class="GtkAdjustment" id="batch_replicates_adjustment">
    <property name="lower">1</property>
    <property name="upper">10000</property>
    <property name="value">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>

</interface>
