\label{tab:expressividade}
\begin{tabular}{@{}lcc@{}}
\toprule
\textbf{Capacidade Analítica} & \textbf{RP Biológica} & \textbf{SHPN + $\Gamma$} \\
\midrule
Balanço de massa                       & \checkmark & \checkmark \\
