\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Programa morfológico da esporulação de \textit  {B.~subtilis} (condição de referência: $\text  {N}_0=1440$~µM, DOSE$=0$, SinR$=12$~µM, $n=50$ réplicas, $t\in [0,360]$~min). \textbf  {Painéis superiores:} reguladores-mestres Spo0A$\sim $P (vermelho) e $\sigma ^H$ (magenta); a linha tracejada horizontal marca a separatriz $\theta _{\sigma H} = 1{,}60$~µM. \textbf  {Painéis inferiores:} montagem morfológica sequencial — Septum, Foresporo, Córtex, Casca Interna, Casca Externa e Esporo Maduro. Curvas: média sobre réplicas; bandas sombreadas: $\pm 1$~dp. A linha tracejada vertical em $t = 334$~min indica a mediana do comprometimento morfológico (primeiro aparecimento de Septum nas réplicas esporulantes).}}{48}{figure.caption.11}\protected@file@percent }
\newlabel{fig:morphological-assembly}{{4.2}{48}{Programa morfológico da esporulação de \textit {B.~subtilis} (condição de referência: $\text {N}_0=1440$~µM, DOSE$=0$, SinR$=12$~µM, $n=50$ réplicas, $t\in [0,360]$~min). \textbf {Painéis superiores:} reguladores-mestres Spo0A$\sim $P (vermelho) e $\sigma ^H$ (magenta); a linha tracejada horizontal marca a separatriz $\theta _{\sigma H} = 1{,}60$~µM. \textbf {Painéis inferiores:} montagem morfológica sequencial — Septum, Foresporo, Córtex, Casca Interna, Casca Externa e Esporo Maduro. Curvas: média sobre réplicas; bandas sombreadas: $\pm 1$~dp. A linha tracejada vertical em $t = 334$~min indica a mediana do comprometimento morfológico (primeiro aparecimento de Septum nas réplicas esporulantes)}{figure.caption.11}{}}
\mph@setcol{ii:48}{\mph@nr}
\mph@setcol{ii:49}{\mph@nr}
