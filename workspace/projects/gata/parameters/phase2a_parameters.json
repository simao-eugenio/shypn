{
  "model_metadata": {
    "name": "GATA1_PU1_Phase2A_Enhanced",
    "version": "2.0.0",
    "description": "Enhanced bistable switch with receptor dynamics, compartments, and metabolic coupling",
    "created": "2026-02-15",
    "base_model": "phase1_minimal_bistable.shy",
    "enhancements": [
      "Receptor binding equilibria (EPOR, GCSFR)",
      "Nuclear/cytoplasmic compartments",
      "ATP/GTP metabolic coupling",
      "Dynamic signal production/clearance"
    ]
  },

  "compartments": {
    "extracellular": {
      "volume_um3": 1000,
      "description": "Extracellular space for signal diffusion"
    },
    "membrane": {
      "area_um2": 10,
      "thickness_nm": 10,
      "description": "Plasma membrane with receptors"
    },
    "cytoplasm": {
      "volume_um3": 1000,
      "description": "Cytoplasmic compartment for translation and signaling"
    },
    "nucleus": {
      "volume_um3": 300,
      "description": "Nuclear compartment for transcription"
    }
  },

  "initial_conditions": {
    "signals": {
      "EPO_external": {"value": 0, "units": "µM", "description": "Extracellular EPO (dynamic)"},
      "GCSF_external": {"value": 0, "units": "µM", "description": "Extracellular GCSF (dynamic)"}
    },
    "receptors": {
      "EPOR_free": {"value": 1000, "units": "receptors/cell", "description": "Free EPO receptors"},
      "EPOR_bound": {"value": 0, "units": "receptors/cell", "description": "EPO:EPOR complex"},
      "EPOR_internalized": {"value": 0, "units": "receptors/cell", "description": "Internalized receptors"},
      "GCSFR_free": {"value": 1500, "units": "receptors/cell", "description": "Free GCSF receptors"},
      "GCSFR_bound": {"value": 0, "units": "receptors/cell", "description": "GCSF:GCSFR complex"},
      "GCSFR_internalized": {"value": 0, "units": "receptors/cell", "description": "Internalized receptors"}
    },
    "gene_layer": {
      "GATA1_Gene": {"value": 1, "units": "copies", "description": "GATA1 gene locus"},
      "PU1_Gene": {"value": 1, "units": "copies", "description": "PU.1 gene locus"}
    },
    "mrna_nuclear": {
      "GATA1_mRNA_nuc": {"value": 5, "units": "molecules", "description": "Nuclear GATA1 mRNA"},
      "PU1_mRNA_nuc": {"value": 5, "units": "molecules", "description": "Nuclear PU.1 mRNA"}
    },
    "mrna_cytoplasmic": {
      "GATA1_mRNA_cyto": {"value": 10, "units": "molecules", "description": "Cytoplasmic GATA1 mRNA"},
      "PU1_mRNA_cyto": {"value": 10, "units": "molecules", "description": "Cytoplasmic PU.1 mRNA"}
    },
    "protein_cytoplasmic": {
      "GATA1_Protein_cyto": {"value": 25, "units": "µM", "description": "Cytoplasmic GATA1 protein"},
      "PU1_Protein_cyto": {"value": 25, "units": "µM", "description": "Cytoplasmic PU.1 protein"}
    },
    "protein_nuclear": {
      "GATA1_Protein_nuc": {"value": 25, "units": "µM", "description": "Nuclear GATA1 (functional TF)"},
      "PU1_Protein_nuc": {"value": 25, "units": "µM", "description": "Nuclear PU.1 (functional TF)"}
    },
    "metabolic_pools": {
      "ATP": {"value": 3000, "units": "µM", "description": "Adenosine triphosphate"},
      "ADP": {"value": 300, "units": "µM", "description": "Adenosine diphosphate"},
      "GTP": {"value": 500, "units": "µM", "description": "Guanosine triphosphate"},
      "GDP": {"value": 50, "units": "µM", "description": "Guanosine diphosphate"},
      "Pi": {"value": 1000, "units": "µM", "description": "Inorganic phosphate"}
    }
  },

  "receptor_binding": {
    "EPO_EPOR": {
      "Kd_nM": 0.1,
      "Kd_uM": 0.0001,
      "kon_per_M_per_s": 1e6,
      "koff_per_s": 0.0001,
      "delta_G_kcal_mol": -12.5,
      "source": "Wojchowski 1989, J Biol Chem",
      "notes": "High affinity binding, physiological Kd ~100 pM"
    },
    "GCSF_GCSFR": {
      "Kd_nM": 0.6,
      "Kd_uM": 0.0006,
      "kon_per_M_per_s": 1e6,
      "koff_per_s": 0.0006,
      "delta_G_kcal_mol": -11.8,
      "source": "Layton 1997, J Biol Chem",
      "notes": "Moderate affinity, Kd ~600 pM"
    },
    "receptor_trafficking": {
      "k_internalization_per_min": 0.1,
      "k_recycling_per_min": 0.05,
      "k_degradation_per_min": 0.015,
      "fraction_recycled": 0.7,
      "fraction_degraded": 0.3,
      "source": "Estimated from general receptor trafficking kinetics"
    }
  },

  "signal_dynamics": {
    "EPO_clearance": {
      "half_life_hours": 5,
      "half_life_minutes": 300,
      "k_clearance_per_min": 0.00231,
      "source": "Egrie 2003, Nephrol Dial Transplant",
      "notes": "First-order clearance kinetics"
    },
    "GCSF_clearance": {
      "half_life_hours": 3.5,
      "half_life_minutes": 210,
      "k_clearance_per_min": 0.0033,
      "source": "Layton 1998, Blood",
      "notes": "Shorter half-life than EPO"
    },
    "signal_production_functions": {
      "constant": {
        "rate": "baseline",
        "example": "0 µM"
      },
      "step": {
        "rate": "baseline if t < t_start else stim",
        "parameters": ["baseline", "stim", "t_start"]
      },
      "pulse": {
        "rate": "baseline + amplitude * pulse(t, t_start, width)",
        "parameters": ["baseline", "amplitude", "t_start", "width"]
      },
      "ramp": {
        "rate": "baseline + (max - baseline) * min(1, t / t_ramp)",
        "parameters": ["baseline", "max", "t_ramp"]
      }
    }
  },

  "nuclear_transport": {
    "protein_import": {
      "k_import_per_min": 0.05,
      "Km_GTP_uM": 50,
      "GTP_stoichiometry": 1,
      "delta_G_kcal_mol": -7,
      "source": "Estimated from importin-mediated transport",
      "notes": "Active GTP-dependent import via nuclear pore"
    },
    "protein_export": {
      "k_export_per_min": 0.001,
      "description": "Basal passive export for homeostasis"
    },
    "mrna_export": {
      "k_export_per_min": 0.1,
      "Km_GTP_uM": 50,
      "GTP_stoichiometry": 1,
      "delta_G_kcal_mol": -7,
      "source": "Estimated from mRNA export machinery",
      "notes": "Requires GTP for nuclear export"
    }
  },

  "transcription": {
    "GATA1": {
      "basal_rate_per_hour": 2.0,
      "signal_enhancement": {
        "alpha": 3.0,
        "Km_signal_uM": 50,
        "description": "EPO signal enhancement factor"
      },
      "self_activation": {
        "beta": 0.5,
        "Km_uM": 5.0,
        "description": "GATA1 positive feedback"
      },
      "cross_repression": {
        "Ki_uM": 15.0,
        "Hill_coefficient": 2,
        "description": "PU.1 inhibition of GATA1"
      },
      "rate_equation": "2.0 * (1 + 0.5*GATA1_Protein_nuc/(5+GATA1_Protein_nuc)) / (1+(PU1_Protein_nuc/15)**2) * (1 + 2*EPO_external/(50+EPO_external))"
    },
    "PU1": {
      "basal_rate_per_hour": 2.0,
      "signal_enhancement": {
        "alpha": 3.0,
        "Km_signal_uM": 50,
        "description": "GCSF signal enhancement factor"
      },
      "self_activation": {
        "beta": 0.5,
        "Km_uM": 5.0,
        "description": "PU.1 positive feedback"
      },
      "cross_repression": {
        "Ki_uM": 15.0,
        "Hill_coefficient": 2,
        "description": "GATA1 inhibition of PU.1"
      },
      "rate_equation": "2.0 * (1 + 0.5*PU1_Protein_nuc/(5+PU1_Protein_nuc)) / (1+(GATA1_Protein_nuc/15)**2) * (1 + 2*GCSF_external/(50+GCSF_external))"
    }
  },

  "translation": {
    "GATA1_mRNA": {
      "k_translation_per_min": 5.0,
      "protein_length_codons": 400,
      "GTP_per_codon": 1,
      "total_GTP_per_protein": 400,
      "translation_time_seconds": 80,
      "source": "Ingolia 2011, assumes 5 AA/sec elongation"
    },
    "PU1_mRNA": {
      "k_translation_per_min": 5.0,
      "protein_length_codons": 400,
      "GTP_per_codon": 1,
      "total_GTP_per_protein": 400,
      "translation_time_seconds": 80
    }
  },

  "degradation": {
    "mRNA": {
      "GATA1_half_life_hours": 4,
      "GATA1_k_deg_per_min": 0.00289,
      "PU1_half_life_hours": 4,
      "PU1_k_deg_per_min": 0.00289,
      "source": "Schwanhausser 2011, Nature (TF mRNA half-lives 2-6 hours)"
    },
    "protein": {
      "GATA1_half_life_hours": 2,
      "GATA1_k_deg_per_min": 0.00578,
      "PU1_half_life_hours": 2,
      "PU1_k_deg_per_min": 0.00578,
      "source": "Schwanhausser 2011, Nature (TF protein half-lives 1-4 hours)"
    }
  },

  "metabolic_rates": {
    "ATP_synthesis": {
      "Vmax_uM_per_min": 1000,
      "Km_ADP_uM": 50,
      "Km_Pi_uM": 100,
      "description": "Mitochondrial ATP synthesis (high capacity)",
      "source": "Estimated from typical cellular ATP turnover"
    },
    "GTP_regeneration": {
      "k_regen_per_min": 100,
      "Km_GDP_uM": 25,
      "Km_ATP_uM": 500,
      "description": "Nucleoside diphosphate kinase: GDP + ATP -> GTP + ADP",
      "source": "Fast enzyme, maintains GTP/GDP ratio"
    },
    "basal_ATP_consumption": {
      "housekeeping_rate_uM_per_min": 100,
      "description": "Background cellular ATP consumption"
    }
  },

  "thermodynamic_constraints": {
    "ATP_depletion_threshold_uM": 100,
    "GTP_depletion_threshold_uM": 50,
    "warnings": {
      "ATP_low": "If ATP < 100 µM: chromatin remodeling slows 10×, translation slows 2×",
      "GTP_low": "If GTP < 50 µM: translation slows 10×, nuclear transport slows 10×"
    },
    "conservation_laws": {
      "ATP_ADP_total": 3300,
      "GTP_GDP_total": 550,
      "EPOR_total": 1000,
      "GCSFR_total": 1500
    }
  },

  "simulation_settings": {
    "default_timespan": {
      "start": 0,
      "end": 100,
      "units": "hours"
    },
    "solver": {
      "method": "Gillespie_SSA",
      "tau_leaping": true,
      "adaptive_timestep": true
    },
    "replicates": {
      "default": 100,
      "description": "Number of stochastic replicates per condition"
    },
    "random_seed": 42
  },

  "parameter_sweep_scenarios": {
    "scenario_1_EPO_dose_response": {
      "description": "Reproduce Phase 1 EPO sweep with enhanced model",
      "swept_parameter": "EPO_external",
      "parameter_type": "production_rate",
      "values": [0, 10, 20, 30, 40, 50],
      "units": "µM",
      "GCSF_external": 0
    },
    "scenario_2_GCSF_dose_response": {
      "description": "Reproduce Phase 1 GCSF sweep with enhanced model",
      "swept_parameter": "GCSF_external",
      "parameter_type": "production_rate",
      "values": [0, 10, 20, 30, 40, 50],
      "units": "µM",
      "EPO_external": 0
    },
    "scenario_3_balanced_competition": {
      "description": "EPO=GCSF to test 50:50 bistability",
      "EPO_external": 50,
      "GCSF_external": 50,
      "expected_outcome": "50:50 erythroid:myeloid split"
    },
    "scenario_4_EPO_pulse": {
      "description": "Transient EPO stimulation",
      "signal_function": "pulse",
      "EPO_amplitude": 40,
      "pulse_start": 0,
      "pulse_width_hours": 2,
      "GCSF_external": 0,
      "test_question": "Is 2-hour pulse sufficient for commitment?"
    },
    "scenario_5_sequential_signals": {
      "description": "EPO then GCSF to test commitment reversibility",
      "phase_1": {"EPO": 40, "GCSF": 0, "duration_hours": 10},
      "phase_2": {"EPO": 0, "GCSF": 40, "duration_hours": 90},
      "test_question": "Can fate switch after 10 hours EPO priming?"
    }
  },

  "validation_criteria": {
    "reproduce_phase1_bistability": {
      "EPO_40_expected_ratio": "33:1 GATA1:PU1",
      "GCSF_40_expected_ratio": "33:1 PU1:GATA1",
      "tolerance": "±20%"
    },
    "energy_conservation": {
      "ATP_ADP_sum": "3300 ± 10%",
      "GTP_GDP_sum": "550 ± 10%"
    },
    "receptor_equilibration": {
      "EPO_EPOR_Kd": "0.0001 µM (100 pM)",
      "equilibration_time": "< 10 minutes"
    },
    "signal_clearance": {
      "EPO_half_life": "5 hours ± 10%",
      "GCSF_half_life": "3.5 hours ± 10%"
    },
    "commitment_timing": {
      "expected_range_hours": "0.5 - 2.0",
      "phase1_value": 0.9,
      "tolerance": "±50%"
    }
  },

  "literature_sources": {
    "receptor_binding": [
      "Wojchowski DM, et al (1989) J Biol Chem - EPO-EPOR Kd",
