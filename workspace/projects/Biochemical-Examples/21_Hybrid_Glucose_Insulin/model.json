    },
    {
      "id": "insulin_protein",
      "name": "Insulin_Protein",
      "tokens": 0,
      "capacity": 200,
      "place_type": "discrete",
      "compartment": "golgi",
      "description": "Insulin protein (accumulates for secretion)"
    },
    {
      "id": "insulin_secreted",
      "name": "Insulin_Secreted",
      "tokens": 0,
      "capacity": 10000,
      "place_type": "continuous",
      "compartment": "blood",
      "description": "Secreted insulin in bloodstream"
    }
  ],
  "transitions": [
    {
      "id": "glucose_import_blood",
      "name": "Glucose_Import_Blood",
      "transition_type": "continuous",
      "rate_function": {
        "type": "mass_action",
        "k": 0.5
      },
      "description": "Dietary glucose uptake into β-cell"
    },
    {
      "id": "glucose_import_liver",
      "name": "Glucose_Import_Liver",
      "transition_type": "continuous",
      "rate_function": {
        "type": "mass_action",
        "k": 0.3
      },
      "description": "Hepatic glucose release → β-cell uptake"
    },
    {
      "id": "glycolysis",
      "name": "Glycolysis",
      "transition_type": "continuous",
      "rate_function": {
        "type": "michaelis_menten",
        "vmax": 2.0,
        "km": 5.0
      },
      "description": "Glucose → G6P (first committed step)"
    },
    {
      "id": "atp_production",
      "name": "ATP_Production",
      "transition_type": "continuous",
      "rate_function": {
        "type": "mass_action",
        "k": 10.0
      },
      "description": "Glycolysis/oxidative phosphorylation → ATP"
    },
    {
      "id": "atp_consumption",
      "name": "ATP_Consumption",
      "transition_type": "continuous",
      "rate_function": {
        "type": "mass_action",
        "k": 0.5
