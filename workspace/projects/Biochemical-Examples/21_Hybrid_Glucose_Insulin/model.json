        "km": 8.0,
        "n": 2.0,
        "regulator": "ATP"
      },
      "description": "ATP-activated insulin gene transcription (STOCHASTIC, REGULATORY coupling)"
    },
    {
      "id": "mrna_degradation",
      "name": "mRNA_Degradation",
      "transition_type": "stochastic",
      "rate_function": {
        "type": "mass_action",
        "k": 0.05
      },
      "description": "mRNA degradation (stochastic)"
    },
    {
      "id": "translation",
      "name": "Insulin_Translation",
      "transition_type": "stochastic",
      "rate_function": {
        "type": "mass_action",
        "k": 0.2
      },
      "description": "mRNA → Insulin protein (stochastic)"
    },
    {
      "id": "protein_degradation",
      "name": "Protein_Degradation",
      "transition_type": "stochastic",
      "rate_function": {
        "type": "mass_action",
        "k": 0.01
      },
      "description": "Insulin protein degradation (stochastic)"
    },
    {
      "id": "insulin_secretion",
      "name": "Insulin_Secretion",
      "transition_type": "continuous",
      "rate_function": {
        "type": "hill_activation",
        "vmax": 5.0,
        "km": 15.0,
        "n": 3.0,
        "regulator": "ATP"
      },
      "description": "ATP-triggered insulin secretion (CONTINUOUS, REGULATORY coupling)"
    }
  ],
