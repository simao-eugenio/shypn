      "compartment": "beta_cell",
      "description": "Energy currency - REGULATES insulin gene transcription"
    },
    {
      "id": "adp",
      "name": "ADP",
      "tokens": 5.0,
      "capacity": 100,
      "place_type": "continuous",
      "chemical_formula": "C10H15N5O10P2",
      "compartment": "beta_cell",
      "description": "Depleted energy"
