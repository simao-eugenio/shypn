  "hormones": {
    "insulin": {
      "name": "Insulin",
      "function": "Anabolic hormone - promotes glycogen synthesis",
      "mechanism": "Activates protein phosphatase 1",
      "effects": [
        "Dephosphorylates glycogen synthase → ACTIVE",
        "Dephosphorylates glycogen phosphorylase → INACTIVE",
        "Promotes glucose uptake (GLUT4 translocation)"
      ],
      "concentration": {
        "fasted": 5.0,
        "fed": 100.0,
        "units": "pM (plasma)",
        "model_scale": "arbitrary units"
      }
    },
    "glucagon": {
      "name": "Glucagon",
      "function": "Catabolic hormone - promotes glycogen breakdown",
      "mechanism": "Activates PKA via cAMP",
      "effects": [
        "Phosphorylates glycogen synthase → INACTIVE",
        "Activates phosphorylase kinase → phosphorylates GP → ACTIVE",
        "Promotes gluconeogenesis"
      ],
      "concentration": {
        "fed": 20.0,
        "fasted": 100.0,
        "units": "pM (plasma)",
        "model_scale": "arbitrary units"
      }
    },
    "epinephrine": {
      "name": "Epinephrine (adrenaline)",
      "function": "Stress hormone - rapid glycogen mobilization",
      "mechanism": "Activates PKA via cAMP (liver and muscle)",
      "effects": [
        "Same as glucagon but faster",
        "Works in muscle (glucagon doesn't)",
        "Ca2+ signaling in muscle"
      ]
    }
  },
  
