  "reactions": {
    "T1_Pyruvate_Transport": {
      "name": "Mitochondrial Pyruvate Carrier (MPC)",
      "ec_number": null,
      "type": "transport",
      "reversible": false,
      "stoichiometry": {
        "substrates": {
          "Pyruvate_cytosol": 1
        },
        "products": {
          "Pyruvate_mito": 1
        }
      },
      "kinetics": {
        "type": "Michaelis-Menten",
        "Vmax": {
          "value": 2.0,
          "unit": "mM/s",
          "reference": "Bricker et al. 2012, PMID: 22628558"
        },
        "Km_Pyruvate": {
          "value": 0.1,
          "unit": "mM",
          "reference": "Estimated from transport kinetics"
        },
        "rate_expression": "2.0 * (Pyruvate_cytosol / (0.1 + Pyruvate_cytosol))"
      },
      "notes": "Carrier-mediated facilitated diffusion"
    },
    "T2_PDH_Complex": {
      "name": "Pyruvate Dehydrogenase Complex",
      "ec_number": "1.2.4.1, 2.3.1.12, 1.8.1.4",
      "kegg_reaction": "R00209",
      "type": "oxidative_decarboxylation",
      "reversible": false,
      "stoichiometry": {
        "substrates": {
          "Pyruvate_mito": 1,
          "CoA": 1,
          "NAD": 1
        },
        "products": {
          "AcetylCoA": 1,
          "CO2": 1,
          "NADH": 1
        }
      },
      "thermodynamics": {
        "delta_G_prime": {
          "value": -33.4,
          "unit": "kJ/mol",
          "reference": "Berg, Biochemistry 7th ed."
        },
        "comment": "Highly exergonic, essentially irreversible"
      },
      "kinetics": {
        "type": "Multi-substrate with product inhibition",
        "Vmax": {
          "value": 0.5,
          "unit": "mM/s",
          "reference": "Patel & Korotchkina 2006, PMID: 16545080"
        },
        "Km_Pyruvate": {
          "value": 0.025,
          "unit": "mM",
          "reference": "Strumilo 2005, PMID: 15799709"
        },
        "Km_CoA": {
          "value": 0.013,
          "unit": "mM",
          "reference": "Patel & Korotchkina 2006"
        },
        "Km_NAD": {
          "value": 0.06,
          "unit": "mM",
          "reference": "Rutter & Denton 1988"
        },
        "Ki_NADH": {
          "value": 0.05,
          "unit": "mM",
          "reference": "Competitive with NAD⁺, Reed 1974"
        },
        "Ki_AcetylCoA": {
          "value": 0.02,
          "unit": "mM",
          "reference": "Competitive with CoA, Reed 1974"
        },
        "rate_expression": "0.5 * (Pyruvate_mito / (0.025 + Pyruvate_mito)) * (CoA / (0.013 + CoA)) * (NAD / (0.06 + NAD)) * (0.05 / (0.05 + NADH)) * (0.02 / (0.02 + AcetylCoA))"
      },
      "regulation": {
        "inhibitors": [
          {
            "compound": "NADH",
            "type": "product_inhibition",
            "mechanism": "Competitive with NAD⁺",
            "Ki": "0.05 mM"
          },
          {
            "compound": "Acetyl-CoA",
            "type": "product_inhibition",
            "mechanism": "Competitive with CoA",
            "Ki": "0.02 mM"
          }
        ],
        "covalent_modification": {
          "type": "Phosphorylation by PDH kinase",
          "effect": "Inactivation",
          "notes": "Not modeled in this example (future extension)"
        }
      },
      "notes": "E1-E2-E3 multienzyme complex, 4-5 MDa molecular weight"
    },
    "T3_Citrate_Synthase": {
      "name": "Citrate Synthase",
      "ec_number": "2.3.3.1",
      "kegg_reaction": "R00351",
      "type": "condensation",
      "reversible": false,
      "stoichiometry": {
        "substrates": {
          "AcetylCoA": 1,
          "Oxaloacetate": 1
        },
        "products": {
          "Citrate": 1,
          "CoA": 1
        }
      },
      "thermodynamics": {
        "delta_G_prime": {
          "value": -31.4,
          "unit": "kJ/mol",
          "reference": "Highly favorable, pulls TCA cycle forward"
        }
      },
      "kinetics": {
        "type": "Sequential ordered bi-bi",
        "Vmax": {
          "value": 0.8,
          "unit": "mM/s",
          "reference": "Williamson & Cooper 1980"
        },
        "Km_AcetylCoA": {
          "value": 0.005,
          "unit": "mM",
          "reference": "Very low Km, high affinity"
        },
        "Km_Oxaloacetate": {
          "value": 0.002,
          "unit": "mM",
          "reference": "Extremely low, rate-limiting substrate"
        },
        "rate_expression": "0.8 * (AcetylCoA / (0.005 + AcetylCoA)) * (Oxaloacetate / (0.002 + Oxaloacetate))"
      },
      "notes": "First committed step of TCA cycle, highly regulated"
    }
