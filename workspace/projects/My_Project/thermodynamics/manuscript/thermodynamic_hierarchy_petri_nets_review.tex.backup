% Title and authors
\title{\textbf{Thermodynamic Constraints Drive Hierarchical Preemption in Cellular Decision-Making: A Hybrid Petri Net Framework with Application to \textit{Bacillus subtilis} Sporulation}}

\author{
Eugênio Simão\textsuperscript{1,*}\\
