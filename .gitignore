# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
# Allow manuscript planning fragments despite the parts/ rule above
!workspace/projects/*/manuscript/parts/
!workspace/projects/*/manuscript/parts/**
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# mypy
.mypy_cache/
.dmypy.json

# Pyre type checker
.pyre/

# VS Code
.vscode/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# Spyder / Rope project settings
.spyderproject
.spyproject
.ropeproject

# Credentials (never commit!)
Token.txt
brenda_credentials.txt

# Workspace cache (user-specific runtime data)
workspace/cache/

# ===== Local-only directories =====
# Legacy backups and archived code — not for any remote
legacy/
archive/

# Documentation (papers, thesis internal docs)
doc/

# ===== Large generated data (workspace projects) =====
# Experiments, simulations, and large data — keep only manuscripts/models/scripts
**/experiments/
**/simulations/
workspace/projects/*/data/
workspace/projects/My_Project/drug_discovery/
workspace/projects/My_Project/extended_biopn/

# ===== Build / generated artifacts =====

# LaTeX auxiliary files
*.aux
*.log
*.bbl
*.blg
*.out
*.bcf
*.run.xml
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# PDF outputs (except manuscript figures)
*.pdf
!workspace/projects/Biochemical-Examples/2*_*/manuscript/*.pdf
!workspace/projects/Biochemical-Examples/2*_*/figures/*.pdf
!workspace/projects/PLOS-One/manuscript/figures/*.pdf
!workspace/projects/PLOS-One/figures/*.pdf
!workspace/projects/Biochemical-Examples/2*_*/scripts/*.pdf

# Hidden files and view state (SHYpn internal)
**/.view_state*.json
**/.*_view_state*.json
**/.project.shy
**/*.Zone.Identifier

# Biochemical-Examples: generated artifacts
workspace/projects/Biochemical-Examples/metadata/
workspace/projects/Biochemical-Examples/results/
workspace/projects/Biochemical-Examples/*/metadata/
workspace/projects/Biochemical-Examples/*/results/
workspace/projects/Biochemical-Examples/models/
workspace/projects/Biochemical-Examples/pathways/

# Debug / cleanup logs
debug.log
CLEANUP_SUMMARY.md
*_ANALYSIS.md
SIMULATION_CONTROLLER_ANALYSIS.md
.backup_pre_refactor
test_output/
benchmark_results/

# CSV outputs — sweep summaries, replicates, dev analyses.
# Often very large; pushes frequently fail. Keep CSVs local; share via
# the run dir on the GPU server / HDD store, not via git.
*.csv

# Backup files (timestamped or plain) — created by in-place model
# patches and editor saves. Keep on disk locally; do not push.
*.bak
*.bak.*

# UI state — recent project list, churns on every workspace open;
# not worth tracking.
workspace/projects/recent_projects.json

# .preserved-<ts> sidecars — produced by ad-hoc cleanup scripts when
# a file is replaced in place. Keep on disk locally; do not push.
*.preserved-*
