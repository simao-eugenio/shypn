# Workspace isolation (user-specific content)
# workspace/examples/ is tracked (demo files)
# workspace/cache/ is user-specific
workspace/cache/

# Legacy backups (pre-UI work safety backups)
legacy/

# ===== GitHub Visibility Control =====
# Hide development materials from public GitHub (keep locally)

# Documentation (papers, thesis, internal docs)
doc/

# Python examples (keep Biochemical-Examples only)
examples/

# Test suite
tests/
test_output/

# Utility scripts (development tools)
scripts/

# CLI tools (experimental/research validation tools)
cli/

# Development utilities (pre-commit, sync scripts)
tools/

# Development and archived code
archive/
dev/

# Note: ui/ directory is tracked (contains GTK XML definitions needed at runtime)

# User workspace (except Biochemical-Examples)
workspace/projects/My_Project/
workspace/projects/thesis/
workspace/projects/*.json
!workspace/projects/Biochemical-Examples/

# Signal hierarchy paper (private development)
workspace/projects/My_Project/signal_hierarchy/

# Biochemical-Examples: exclude generated artifacts
workspace/projects/Biochemical-Examples/metadata/
workspace/projects/Biochemical-Examples/results/
workspace/projects/Biochemical-Examples/*/metadata/
workspace/projects/Biochemical-Examples/*/results/

