<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version1/core" level="3" version="1">
  <model id="simple_two_compartment" name="Simple Two Compartment Model">
    
    <!-- Compartments -->
    <listOfCompartments>
      <compartment id="cytoplasm" name="Cytoplasm" spatialDimensions="3" size="1" constant="true"/>
      <compartment id="mitochondrion" name="Mitochondrion" spatialDimensions="3" size="0.2" constant="true"/>
    </listOfCompartments>
    
    <!-- Species -->
    <listOfSpecies>
      <!-- Cytoplasm species -->
      <species id="Glucose" name="Glucose" compartment="cytoplasm" initialConcentration="5" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="G6P" name="Glucose-6-Phosphate" compartment="cytoplasm" initialConcentration="2" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="Pyruvate" name="Pyruvate" compartment="cytoplasm" initialConcentration="1" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="ATP_cyt" name="ATP (Cytoplasm)" compartment="cytoplasm" initialConcentration="3" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="ADP_cyt" name="ADP (Cytoplasm)" compartment="cytoplasm" initialConcentration="1" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      
      <!-- Mitochondrion species -->
      <species id="Pyruvate_mit" name="Pyruvate (Mitochondrion)" compartment="mitochondrion" initialConcentration="0.5" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="AcetylCoA" name="Acetyl-CoA" compartment="mitochondrion" initialConcentration="1" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="ATP_mit" name="ATP (Mitochondrion)" compartment="mitochondrion" initialConcentration="5" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="ADP_mit" name="ADP (Mitochondrion)" compartment="mitochondrion" initialConcentration="0.5" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    
    <!-- Parameters -->
    <listOfParameters>
      <parameter id="k1" value="0.1" constant="true"/>
      <parameter id="k2" value="0.05" constant="true"/>
      <parameter id="k3" value="0.08" constant="true"/>
      <parameter id="k4" value="0.15" constant="true"/>
      <parameter id="k5" value="0.2" constant="true"/>
    </listOfParameters>
    
    <!-- Reactions -->
    <listOfReactions>
      <!-- Cytoplasm reactions -->
      <reaction id="Hexokinase" name="Glucose Phosphorylation" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="Glucose" stoichiometry="1" constant="true"/>
          <speciesReference species="ATP_cyt" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="G6P" stoichiometry="1" constant="true"/>
          <speciesReference species="ADP_cyt" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci>k1</ci>
              <ci>Glucose</ci>
              <ci>ATP_cyt</ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      
      <reaction id="Glycolysis" name="Glycolysis" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="G6P" stoichiometry="1" constant="true"/>
          <speciesReference species="ADP_cyt" stoichiometry="2" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="Pyruvate" stoichiometry="2" constant="true"/>
          <speciesReference species="ATP_cyt" stoichiometry="4" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci>k2</ci>
              <ci>G6P</ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      
      <!-- Cross-compartment transport -->
      <reaction id="Pyruvate_Transport" name="Pyruvate Transport to Mitochondrion" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="Pyruvate" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="Pyruvate_mit" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <listOfModifiers>
          <modifierSpeciesReference species="ATP_mit"/>
        </listOfModifiers>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci>k3</ci>
              <ci>Pyruvate</ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      
      <!-- Mitochondrion reactions -->
      <reaction id="PDH" name="Pyruvate Dehydrogenase" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="Pyruvate_mit" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="AcetylCoA" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci>k4</ci>
              <ci>Pyruvate_mit</ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      
      <reaction id="OxPhos" name="Oxidative Phosphorylation" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="AcetylCoA" stoichiometry="1" constant="true"/>
          <speciesReference species="ADP_mit" stoichiometry="12" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="ATP_mit" stoichiometry="12" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci>k5</ci>
              <ci>AcetylCoA</ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      
      <!-- ATP/ADP exchange (cross-compartment) -->
      <reaction id="ATP_Transport" name="ATP Transport to Cytoplasm" reversible="true" fast="false">
        <listOfReactants>
          <speciesReference species="ATP_mit" stoichiometry="1" constant="true"/>
          <speciesReference species="ADP_cyt" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="ADP_mit" stoichiometry="1" constant="true"/>
          <speciesReference species="ATP_cyt" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <cn>0.1</cn>
              <apply>
                <minus/>
                <ci>ATP_mit</ci>
                <ci>ATP_cyt</ci>
              </apply>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
    
  </model>
</sbml>
